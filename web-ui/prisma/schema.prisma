// Local indexed database for the Next.js cache/wrapper server (Module B in the HLD).
// This is a read-optimized *mirror* of on-chain state plus off-chain review text/ratings -
// the blockchain (contracts/contracts/DappStore.sol) remains the source of truth for
// everything except review free-text, which is aggregated and anchored back on-chain as a
// hash (see updateReviews and src/lib/reviews-aggregator.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors the on-chain App struct + a few cache-only fields (rating/report rollups) that
// would be expensive to compute on-chain on every read.
model App {
  id                Int       @id // == on-chain appId, never auto-generated here
  publisher         String
  name              String
  description       String
  tags              String[]
  latestVersionId   Int
  latestReviewsHash String    @default("")
  latestReviewsRef  String    @default("") // magnet link of the aggregated reviews blob
  latestReportsHash String    @default("")
  latestReportsRef  String    @default("") // magnet link of the aggregated reports blob
  reportCount       Int       @default(0) // cache-only rollup (like averageRating) - see reports-aggregator.ts
  downloadCount     Int       @default(0) // off-chain only - counts POST /api/download calls, never on-chain
  averageRating     Float     @default(0)
  ratingCount       Int       @default(0)
  // Full "data:image/png;base64,..." / "data:image/jpeg;base64,..." URI, ready to drop straight
  // into an <Avatar src>/<img> with no extra request - never part of the on-chain App struct,
  // set by the developer after publishing (see api/apps/[id]/icon/route.ts). Null means no icon
  // was ever uploaded; the UI falls back to a plain initial-letter avatar.
  icon              String?
  publishedAt       DateTime
  updatedAt         DateTime  @updatedAt

  versions Version[]
  reviews  Review[]
  reports  Report[]

  @@index([name])
}

// Mirrors the on-chain Version struct so version history/torrent refs can be listed without
// a chain call per row.
model Version {
  id           Int      @id @default(autoincrement())
  appId        Int
  versionId    Int
  torrentRef   String
  sha256Digest String
  // Developer-supplied "what's new" text - off-chain only, never part of the on-chain Version
  // struct, set after publishNewVersion() confirms (see api/apps/[id]/versions/[versionId]/notes).
  releaseNotes String?
  publishedAt  DateTime

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, versionId])
}

// Individual reviews as submitted by users. `aggregated` flags rows already folded into an
// on-chain latestReviewsHash anchor (see the hash-chaining scheme from the meeting notes);
// review text itself is never deleted, only marked, so the aggregation history stays honest.
model Review {
  id          Int      @id @default(autoincrement())
  appId       Int
  reviewer    String
  rating      Int?
  reviewText  String
  isDeveloper Boolean  @default(false)
  aggregated  Boolean  @default(false)
  createdAt   DateTime @default(now())

  app App @relation(fields: [appId], references: [id])

  @@index([appId])
}

// Individual reports as submitted by users, mirroring Review exactly: reports accumulate
// off-chain (no gas cost, no on-chain transaction at submission time - see
// api/reports/route.ts), and once enough pile up, reports-aggregator.ts hashes+seeds the full
// history and anchors just that hash on-chain via updateReports. `aggregated` flags rows
// already folded into an on-chain latestReportsHash anchor; report rows are never deleted, so
// the full history stays servable from Postgres for the Reports tab. `signature` is the
// reporter's signed proof of wallet ownership over (appId, reason) - required since, unlike the
// old on-chain reportApp(), submitting a report is no longer a transaction the reporter's own
// wallet had to sign and pay gas for; see lib/report-signing.ts for the exact signed message
// and api/reports/route.ts for verification. The (appId, reporter) unique constraint replicates
// the old on-chain hasReported mapping's one-report-per-wallet-per-app guarantee.
model Report {
  id         Int      @id @default(autoincrement())
  appId      Int
  reporter   String
  reason     String
  signature  String
  aggregated Boolean  @default(false)
  createdAt  DateTime @default(now())

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, reporter])
  @@index([appId])
}

// Single-row table the BlockchainListener uses to resume from the last block it processed,
// instead of re-scanning the whole chain from genesis on every server restart.
model SyncState {
  id        Int @id @default(1)
  lastBlock Int @default(0)
}

// Maps a wallet address to a display name the user chose for themselves, purely a UI-level
// convenience layered on top of the on-chain publisher address (see api/profile/route.ts).
// Nothing on-chain, and no App/Version row, ever references this table - every existing
// publisher reference keeps using the raw address, and this is only ever consulted at render
// time to look up a friendlier label for it. A wallet with no row here just has no username
// yet (the UI falls back to a truncated address).
model User {
  walletAddress String @unique
  username      String
}
